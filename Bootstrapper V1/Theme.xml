<!-- i'd recommended using windows 11 for a complete proper bootstrapper UI design. -->
<BloxstrapCustomBootstrapper Version="1" Height="270" Width="500" Theme="Dark" IgnoreTitleBarInset="True" Margin="0" >
	<BloxstrapCustomBootstrapper.Background>
	<SolidColorBrush Color="#202020" Opacity="1" />
	</BloxstrapCustomBootstrapper.Background>
	<!-- Custom bootstrapper examples at https://github.com/bloxstraplabs/custom-bootstrapper-examples [to those reading this and want to modify something here] -->
	<Image Source="theme://bloxstrapbackgroundorsmth.jpg" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-15,-5,0" Opacity="0.4" /> <!-- intentional, was meant to be imagebrush but it causes conflicts with solidcolorbrush -->
	<TitleBar Title="Roblox Bootstrapper" ShowMinimize="False" ShowClose="True" />
	<Image Source="{Icon}" Height="80" Width="80" HorizontalAlignment="Center" Margin="0,37.5,0,0" />
	<TextBlock HorizontalAlignment="Center" Name="StatusText" FontSize="18" Margin="0,137.5,0,0" />
	<ProgressBar Width="400" Height="12" Name="PrimaryProgressBar" HorizontalAlignment="Center" Margin="0,165,0,0" />
	<TextBlock HorizontalAlignment="Center" Name="INFOOO" FontSize="12" Margin="0,180,0,0" Opacity="0.7" Text="Preparing Roblox, this should not take longer than 10 seconds." />
	<TextBlock HorizontalAlignment="Center" Name="INFOOO2" FontSize="12" Margin="0,195,0,0" Opacity="0.7" Text="If Roblox is updating, it may take up to 2 minutes." />
	<Image Source="theme://Bloxstrap-full-dark.png" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="100" Margin="10,0,0,10" Opacity="1" />
	<Button Content="{Common.Cancel}" Name="CancelButton" HorizontalAlignment="Center" Margin="0,217.5,0,0" Height="30" Width="80" />
</BloxstrapCustomBootstrapper>