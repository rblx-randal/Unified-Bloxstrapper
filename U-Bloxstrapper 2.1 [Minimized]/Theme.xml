<!-- i'd recommended using windows 11 for a complete proper bootstrapper UI design. -->
<BloxstrapCustomBootstrapper Version="1" Height="280" Width="500" Theme="Dark" IgnoreTitleBarInset="True" Margin="0" WindowCornerPreference="Round" WindowBackdropType="Aero" >
	<BloxstrapCustomBootstrapper.Background>
	<SolidColorBrush Color="#191a1f" Opacity="1" />
	</BloxstrapCustomBootstrapper.Background>
	<!-- Custom bootstrapper examples at https://github.com/bloxstraplabs/custom-bootstrapper-examples [to those reading this and want to modify something here] -->
		<Image Source="theme://1500x500Roblox.jpeg" Width="685" Margin="0,0,0,30" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Top" />
			<Rectangle Name="betterstatusreadabilityfog" Width="500" Height="75" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,50" Opacity="1"><Rectangle.Fill><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#00000000" Offset="1"/><GradientStop Color="#191a1f" Offset="0"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
			<Image Source="{Icon}" Name="Logo" Height="100" Width="100" HorizontalAlignment="Center" Margin="0,62.5,0,0" Opacity="0" />
			<Rectangle Width="500" Height="52" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,0" Opacity="0.55" > <Rectangle.Fill><LinearGradientBrush StartPoint="0.05,0" EndPoint="0.8,15"> <GradientStop Color="#0b0c0e" Offset="0.1"/><GradientStop Color="#5a6272" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
			<TitleBar Title="" ShowMinimize="False" ShowClose="True" />
			<Image Source="{Icon}" Name="TitleImage" Height="14" Width="14" HorizontalAlignment="Left" Margin="9.15,9.15,0,0" />
			<TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" Name="StatusText" FontSize="18" Margin="0,0,0,62.5" />
			<Rectangle Width="500" Height="2" HorizontalAlignment="Center" Margin="0,0,0,50.5" VerticalAlignment="Bottom" Opacity="0.25"><Rectangle.Fill><LinearGradientBrush StartPoint="0.05,0" EndPoint="1,0"><GradientStop Color="#FFFFFF" Offset="1"/><GradientStop Color="#00000000" Offset="0"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
			<ProgressBar Width="502" Height="3" Name="PrimaryProgressBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,1,50" />
			<TextBlock HorizontalAlignment="Right" Name="INFOOO" FontSize="9.5" FontWeight="Regular" Margin="0,0,95,26.5" Opacity="0.6" VerticalAlignment="Bottom" Text="Preparing Roblox. Should not take longer than 10 seconds." />
			<TextBlock HorizontalAlignment="Right" Name="INFOOO2" FontSize="9.5" FontWeight="Regular" Margin="0,0,95,13.5" VerticalAlignment="Bottom" Opacity="0.6" Text="If Roblox is updating, it may take up to 2 minutes." />
			<Image Source="theme://FishstrapLogoDarkMonochrome.png" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="110" Margin="15,0,0,10.5" Opacity="1" />
			<Button Content="{Common.Cancel}" Name="CancelButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10.5" Height="30" Width="80" />
</BloxstrapCustomBootstrapper>